# Set this to the permanent public origin before deployment.
NEXT_PUBLIC_SITE_URL=https://dapolice.vercel.app

# Set to a monitored public email address before publishing Contact.
NEXT_PUBLIC_CONTACT_EMAIL=

# The publisher script is included for site verification; set false to omit it.
NEXT_PUBLIC_ADSENSE_SCRIPT_ENABLED=true
# Keep ad placements disabled until Google approves the site and required setup is complete.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-2635367930409387
# Supply an approved slot ID as the slot prop when adding a reviewed placement.
NEXT_PUBLIC_ADSENSE_CONTENT_SLOT=
